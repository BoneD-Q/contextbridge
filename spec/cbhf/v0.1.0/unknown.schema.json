{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextbridge.dev/spec/cbhf/v0.1.0/unknown.schema.json",
  "title": "CBHF 0.1.0 unknowns",
  "description": "Schema for uncertainty/unknowns.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["unknowns"],
  "properties": {
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/UnknownItem" }
    }
  },
  "$defs": {
    "UnknownItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "question"],
      "properties": {
        "unknown_id": { "type": "string" },
        "question": {
          "$ref": "common.schema.json#/$defs/LocalizedString"
        },
        "why_it_matters": {
          "$ref": "common.schema.json#/$defs/LocalizedString"
        },
        "related_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggested_owner": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
