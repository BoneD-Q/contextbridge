{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextbridge.dev/spec/cbhf/v0.1.0/claim.schema.json",
  "title": "CBHF 0.1.0 claims",
  "description": "Schema for knowledge/claims.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/Claim" }
    }
  },
  "$defs": {
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement", "status"],
      "properties": {
        "claim_id": { "type": "string" },
        "statement": {
          "$ref": "common.schema.json#/$defs/LocalizedString"
        },
        "context": {
          "$ref": "common.schema.json#/$defs/KnowledgeContext"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/KnowledgeStatus"
        },
        "kind": {
          "type": "string",
          "enum": [
            "assertion",
            "interpretation",
            "prediction",
            "requirement_claim",
            "other"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_fact_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confirmation": {
          "$ref": "common.schema.json#/$defs/ConfirmationOrNull"
        },
        "conflict_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/KnowledgeStatusGates"
        }
      ]
    }
  }
}
